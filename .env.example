# Строка подключения к PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sporim

# Секрет для подписи JWT. ОБЯЗАТЕЛЬНО замените в production!
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS: список origin'ов через запятую (фронтенд Vite)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Стартовый баланс нового пользователя в виртуальных баллах
DEFAULT_BALANCE=1000

# Окружение
ENVIRONMENT=development
DEBUG=true
SQL_ECHO=false
